# Copy this file to .env and change the local development password before use.
POSTGRES_DB=universal_growth
POSTGRES_USER=uga
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=15432
REDIS_PORT=16379

# Backend settings use the UGA_ prefix.
UGA_ENVIRONMENT=development
UGA_LOG_LEVEL=INFO
UGA_DATABASE_URL=postgresql+psycopg://uga:change-this-local-password@127.0.0.1:15432/universal_growth
UGA_REDIS_URL=redis://127.0.0.1:16379/0
UGA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional authorization boundaries.
# UGA_API_KEY=your-secret-api-key
# UGA_WORKSPACE_OWNER=default

# Optional dashboard override. The default is http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000

# Phase 6 integration credential encryption (Fernet key, required for credential storage).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# UGA_CREDENTIAL_ENCRYPTION_KEY=

# Phase 6 approval time-to-live in seconds (default 86400 = 24h).
# UGA_APPROVAL_TTL_SECONDS=86400
